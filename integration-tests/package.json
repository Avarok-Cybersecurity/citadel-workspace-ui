{
  "name": "cw-integration-tests",
  "version": "1.0.0",
  "description": "Integration tests for Citadel Workspace",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node dist/tests/p2p-messaging.test.js",
    "test:p2p": "npm run build && node dist/tests/p2p-messaging.test.js",
    "test:live-doc": "npm run build && node dist/tests/live-doc-sync.test.js",
    "test:group": "npm run build && node dist/tests/group-messaging.test.js",
    "test:group-multiuser": "npm run build && node dist/tests/group-messaging-multiuser.test.js",
    "test:office-chat": "npm run build && node dist/tests/group-chat/office-chat.test.js",
    "test:room-chat": "npm run build && node dist/tests/group-chat/room-chat.test.js",
    "test:peer-group": "npm run build && node dist/tests/group-chat/peer-group.test.js",
    "test:all-group": "npm run test:office-chat && npm run test:room-chat && npm run test:peer-group",
    "test:crud": "npm run build && node dist/tests/office-room-crud.test.js",
    "test:login": "npm run build && node dist/tests/login-flow.test.js",
    "test:prev-sessions": "npm run build && node dist/tests/previous-sessions.test.js",
    "test:file-transfer": "npm run build && node dist/tests/file-transfer.test.js",
    "test:offline": "npm run build && node dist/tests/offline-messaging.test.js",
    "test:hard-disconnect": "npm run build && node dist/tests/hard-disconnect-offline.test.js",
    "test:permissions": "npm run build && node dist/tests/permissions.test.js",
    "test:admin-modal": "npm run build && node dist/tests/admin-modal.test.js",
    "test:directory": "npm run build && node dist/tests/user-directory.test.js",
    "test:files": "npm run build && node dist/tests/file-manager.test.js",
    "test:file-manager": "npm run build && node dist/tests/file-manager.test.js",
    "test:revfs": "npm run build && node dist/tests/revfs-peer.test.js",
    "test:revfs:peer": "npm run build && node dist/tests/revfs-peer.test.js",
    "test:revfs:server": "npm run build && node dist/tests/revfs-server.test.js",
    "test:notifications": "npm run build && node dist/tests/notification-center.test.js",
    "test:settings": "npm run build && node dist/tests/settings-modal.test.js",
    "test:workspace-init": "npm run build && node dist/tests/workspace-init.test.js",
    "test:tree-structure": "npm run build && node dist/tests/tree-structure-editor.test.js",
    "test:tree": "npm run build && node dist/tests/tree-validator-protocol.test.js && node dist/tests/tree-move-operations.test.js && node dist/tests/tree-cascade-delete.test.js && node dist/tests/tree-custom-types.test.js && node dist/tests/tree-deep-hierarchy.test.js && node dist/tests/tree-permissions-inheritance.test.js",
    "test:tree-validator": "npm run build && node dist/tests/tree-validator-protocol.test.js",
    "test:tree-move": "npm run build && node dist/tests/tree-move-operations.test.js",
    "test:tree-cascade": "npm run build && node dist/tests/tree-cascade-delete.test.js",
    "test:tree-custom-types": "npm run build && node dist/tests/tree-custom-types.test.js",
    "test:tree-deep": "npm run build && node dist/tests/tree-deep-hierarchy.test.js",
    "test:tree-permissions": "npm run build && node dist/tests/tree-permissions-inheritance.test.js",
    "test:all": "npm run test:p2p && npm run test:crud && npm run test:login && npm run test:prev-sessions && npm run test:all-group && npm run test:offline && npm run test:hard-disconnect && npm run test:permissions && npm run test:admin-modal",
    "test:ui": "npm run test:directory && npm run test:files && npm run test:notifications && npm run test:settings && npm run test:workspace-init",
    "typecheck": "tsc --noEmit",
    "lint": "npx eslint .",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "typescript-eslint": "^8.20.0"
  },
  "dependencies": {
    "playwright": "^1.57.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
